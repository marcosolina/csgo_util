# Copy to ".env" next to compose.yml on each host and fill it in. The real .env never goes into git.
# Keep every key; a host leaves the ones it does not use empty (Compose warns about missing keys).

# Services this host runs (profiles in compose.yml):
#   mini-pc: infra,gateway,services,db · ds1522 (NAS): dem
COMPOSE_PROFILES=

# Images. Pin TAG to a git commit (for example 0d3a7f2f) to roll back; "next" is the pre-release tag.
REGISTRY=docker-registry.marco.selfip.net
TAG=latest

# This host's LAN address, for example 192.168.1.24 on mini-pc. Every service on this host registers
# it in Eureka, so the proxy reaches the published port (dem-manager on the NAS: ds1522).
HOST_ADDRESS=

# Shared by every Spring service (all hosts except db)
IXIGO_PROFILE=rasp
IXIGO_CONFIG_SERVER_URI=http://192.168.1.24:8888/config
IXIGO_EUREKA_SERVER=http://192.168.1.24:8765/discovery/eureka
IXIGO_CONFIG_SERVER_USER=
IXIGO_CONFIG_SERVER_PASSW=

# Config Server (infra): key that decrypts the {cipher} values in csgo_props, and its branch
IXIGO_CONFIG_ENC_KEY=
IXIGO_GIT_REPO_BRANCH=main

# Database: the Postgres superuser (db) and the account of dem-manager, discord-bot, event-dispatcher
POSTGRES_USER=
POSTGRES_PASSWORD=
# db: gateway in the seeded event listener URLs; empty keeps https://marco.selfip.net/ixigoproxy
IXIGO_LISTENERS_BASE_URL=

# discord-bot
DISCORD_BOT_TOKEN=
# rcon-api: RCON password of the game server
IXIGO_CSGO_PASSW=

# dem-manager (dem): folder of the .dem files on this host, and the uid:gid that owns it
# (find it with: stat -c %u:%g /path/to/folder)
DEM_FOLDER=
DEM_MANAGER_USER=1000:1000
DEM_MANAGER_MEM_LIMIT=3g

# Memory limit of each Java service container; the JVM heap is 75% of it (the jars use 300 to 400 MB today)
JAVA_MEM_LIMIT=768m

# reparse (tools): dem-manager base URL, reachable from the host that runs the reparse
DEM_MANAGER_URL=http://192.168.1.237:8090/demmanager
