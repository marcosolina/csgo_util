<?xml version="1.0" encoding="UTF-8"?>
<!--
    Aggregator only: it lists the Maven modules so one command builds them in
    dependency order. It is NOT a parent; each module keeps its own parent
    (IxigoParent, spring-boot-starter-parent, or none).

    mvn -B package                                       build everything
    mvn -B -pl IxigoDemManager -am package               one service plus what it needs
    mvn -B -P integration-tests test                     Cucumber suite (needs the running stack)

    Not listed: IxigoUtils (one-off generator, depends on com.marco:Utils which is
    not published to Maven Central).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.ixigo</groupId>
	<artifactId>IxigoBuild</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>IxigoBuild</name>
	<description>Aggregator that builds every IxiGo Maven module</description>

	<modules>
		<!-- Shared libraries -->
		<module>IxigoParent</module>
		<module>IxigoLibrary</module>
		<module>IxigoDemManagerContract</module>
		<module>IxigoDiscordBotContract</module>
		<module>IxigoEventDispatcherContract</module>
		<module>IxigoNotificationContract</module>
		<module>IxigoPlayersManagerContract</module>
		<module>IxigoRconApiContract</module>
		<module>IxigoServerHelperContract</module>

		<!-- Spring Cloud infrastructure -->
		<module>IxigoConfigServer</module>
		<module>IxigoDiscovery</module>
		<module>IxigoProxy</module>

		<!-- Business services -->
		<module>IxigoDemManager</module>
		<module>IxigoDiscordBot</module>
		<module>IxigoEventDispatcher</module>
		<module>IxigoNotification</module>
		<module>IxigoPlayersManager</module>
		<module>IxigoRconApi</module>
		<module>IxigoServerHelper</module>
		<module>IxigoUi</module>
	</modules>

	<profiles>
		<profile>
			<id>integration-tests</id>
			<modules>
				<module>IxigoIntegrationTests</module>
			</modules>
		</profile>
	</profiles>
</project>
